# Copy to .env. Use KEY=value without quotes or shell variable expansion.
SERVER_PORT=8080
APP_HOST_PORT=8080
SPRING_PROFILES_ACTIVE=local
DOCKERHUB_USERNAME=your-dockerhub-username
CORS_ALLOWED_ORIGINS=http://localhost:3000

TZ=Asia/Seoul

# IntelliJ and EC2 both use LOCAL_DB_* for an externally managed MySQL database.
# For EC2, replace the host in LOCAL_DB_URL with the RDS endpoint.
# For a Docker app connecting to MySQL on this PC, use host.docker.internal instead of localhost.
LOCAL_DB_URL=jdbc:mysql://localhost:3306/mallang?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=mallang
LOCAL_DB_PASSWORD=change-me
